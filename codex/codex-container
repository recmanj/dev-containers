#!/usr/bin/env bash
set -euo pipefail

IMAGE="ghcr.io/recmanj/dev-containers/codex:latest"
CONTAINER_HOME=/home/dev
HOST_PATH="$(pwd)"
VOLUME_NAME="dev-container-$(printf '%s' "$HOST_PATH" | shasum -a 256 | cut -c1-12)"
LOCAL_CONFIG_PATH="$HOME/.config/dev-containers"

TTY_FLAGS=(-i)
[ -t 0 ] && [ -t 1 ] && TTY_FLAGS=(-it)

EXTRA_ARGS=()
# Inside a git worktree, .git points at the main repo's git dir; mount it too
# so git works in the container.
GIT_COMMON_DIR="$(git -C "$HOST_PATH" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
case "$GIT_COMMON_DIR" in
  "" | "$HOST_PATH"/*) ;;
  *) EXTRA_ARGS+=(-v "$GIT_COMMON_DIR":"$GIT_COMMON_DIR") ;;
esac

# t3code hands the agent paths to uploaded files; mount them read-only.
T3_ATTACHMENTS="${T3CODE_HOME:-$HOME/.t3}/userdata/attachments"
if [ -d "$T3_ATTACHMENTS" ]; then
  EXTRA_ARGS+=(-v "$T3_ATTACHMENTS":"$T3_ATTACHMENTS":ro)
fi

# Forward OpenAI settings from the environment (e.g. GUI per-provider env vars),
# plus any names listed in DEV_CONTAINER_ENV.
for var in $(compgen -e); do
  case "$var" in OPENAI_*) EXTRA_ARGS+=(-e "$var") ;; esac
done
for var in ${DEV_CONTAINER_ENV:-}; do EXTRA_ARGS+=(-e "$var"); done

# Python: uv keeps the project venv in a per-project volume outside the
# project tree, so no .venv appears on the host.
DEP_ARGS=(
  -e UV_PROJECT_ENVIRONMENT="$CONTAINER_HOME/.project-venv"
  -v "$VOLUME_NAME-uv-venv":"$CONTAINER_HOME/.project-venv"
)
# Node can't relocate node_modules, so shadow it with a volume to keep
# container-built packages off the host. It is mounted even without a
# package.json, so a project the agent creates mid-session is covered too.
# The mount point shows up as an empty dir on the host; it is removed on exit.
NODE_MODULES_VOLUME="$VOLUME_NAME-node_modules"
DEP_ARGS+=(-v "$NODE_MODULES_VOLUME":"$HOST_PATH/node_modules")

podman run "${TTY_FLAGS[@]}" --rm \
  --userns=keep-id:uid=1000,gid=1000 \
  --security-opt no-new-privileges \
  --security-opt 'unmask=/proc/*' \
  --cap-drop all \
  --env-file "$LOCAL_CONFIG_PATH/.env" \
  -e AZURE_OPENAI_API_KEY \
  -v ~/.codex:$CONTAINER_HOME/.codex \
  -v "$HOST_PATH":"$HOST_PATH" \
  "${DEP_ARGS[@]}" \
  -v "$LOCAL_CONFIG_PATH/github":"$CONTAINER_HOME/.ssh/github":ro \
  ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"} \
  -w "$HOST_PATH" \
  -- \
  "$IMAGE" \
  "$@" <&0 &
PODMAN_PID=$!
# Run podman in the background so the cleanup below still runs when the
# wrapper is signalled (e.g. t3code stopping a session); forward each signal
# unchanged.
for sig in INT TERM HUP; do
  trap "kill -$sig \"\$PODMAN_PID\" 2>/dev/null" "$sig"
done
set +e
wait "$PODMAN_PID"
STATUS=$?
while kill -0 "$PODMAN_PID" 2>/dev/null; do
  wait "$PODMAN_PID"
  STATUS=$?
done

# Remove the empty node_modules mount point, unless another container for
# this project still has it mounted. rmdir never removes a non-empty dir.
if [ -d "$HOST_PATH/node_modules" ] &&
  [ -z "$(podman ps -q --filter volume="$NODE_MODULES_VOLUME" 2>/dev/null)" ]; then
  rmdir "$HOST_PATH/node_modules" 2>/dev/null
fi
exit "$STATUS"

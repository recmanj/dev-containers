# Podman Quadlet: runs the t3code server as a systemd user service.
# Install: copy to ~/.config/containers/systemd/, then
#   systemctl --user daemon-reload && systemctl --user start t3
[Unit]
Description=t3code server

[Container]
Image=ghcr.io/recmanj/dev-containers/t3:latest
ContainerName=t3
UserNS=keep-id:uid=1000,gid=1000
NoNewPrivileges=true
DropCapability=all
Unmask=/proc/*
PublishPort=127.0.0.1:3773:3773
EnvironmentFile=%h/.config/dev-containers/.env
# Use the host's home path inside the container, so ~ and project paths are
# the same on both sides. The home itself (t3 data in .t3, caches) is kept in
# ~/.config/dev-containers/t3.
Environment=HOME=%h
WorkingDir=%h
Volume=%h/.config/dev-containers/t3:%h
Volume=%h/.claude:%h/.claude
Volume=%h/.claude.json:%h/.claude.json
Volume=%h/.codex:%h/.codex
Volume=%h/Code:%h/Code
# Add a line like this for each project folder outside ~/Code:
#Volume=%h/Projects:%h/Projects
# ssh finds keys via the image user's home, not $HOME.
Volume=%h/.config/dev-containers/github:/home/dev/.ssh/github:ro

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
